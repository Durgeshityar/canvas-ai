# Database (Neon Serverless PostgreSQL)
# Get from: https://neon.tech → Create project → Connection string
DATABASE_URL=

# NextAuth Authentication
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth
# Get from: https://github.com/settings/developers → New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Replicate AI (image generation + background removal)
# Get from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Unsplash (stock images)
# Get from: https://unsplash.com/developers → New Application
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=

# UploadThing (file uploads)
# Get from: https://uploadthing.com/dashboard
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# Stripe (payments & subscriptions)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Get from: Stripe Dashboard → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=
# Get from: Stripe Dashboard → Products → Price ID
STRIPE_PRICE_ID=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
